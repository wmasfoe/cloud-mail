# ============================================================
# cloud-mail IMAP 网关部署配置(复制为 .env 后修改)
# 用法:cp .env.example .env && vim .env && sudo bash install.sh
# ============================================================

# cloud-mail Worker 的 API 根地址(你部署 Worker 的域名,如 https://mail.example.com)
API_BASE_URL=https://mail.example.com

# 网关专用密钥 —— 必须与 Worker 端 wrangler 配置里的 gateway_key 完全一致!
GATEWAY_KEY=please-change-me

# IMAP 监听端口(生产用 993;本机调试可用 1143 明文)
IMAP_PORT=993

# SMTP 发信监听端口(生产用 465 SMTPS;M2 起支持)
SMTP_PORT=465

# TLS 证书路径(certbot 签发后填入;留空则明文运行,仅限调试)
TLS_CERT=
TLS_KEY=

# --- 可选:证书自动签发(推荐,换 VPS 时零手工) ---
# 填写后 install.sh 会自动用 certbot DNS 挑战签发 Let's Encrypt 证书并配置自动续期
# 要求:域名在 Cloudflare 托管;CF_DNS_API_TOKEN 需有 DNS:Edit 权限;DNS 记录先指向本机
TLS_DOMAIN=
CF_DNS_API_TOKEN=
CERTBOT_EMAIL=you@example.com

# IDLE 推送轮询间隔(毫秒,默认 30 秒)
IDLE_POLL_MS=30000

# 分页大小(网关拉取邮件列表的批量大小,默认 100)
PAGE_SIZE=100
